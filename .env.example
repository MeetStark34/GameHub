# --- Database -------------------------------------------------------------
# Production: Supabase Postgres connection string (Settings -> Database).
# On Vercel use the transaction pooler (port 6543). Never expose to the browser.
# Leave unset locally to use the embedded PGlite database in ./.data/pglite.
DATABASE_URL=

# Optional: override the local PGlite data directory.
# PGLITE_DATA_DIR=.data/pglite

# --- App ------------------------------------------------------------------
# Public origin used for metadata, sitemap and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign guest/session cookies' CSRF tokens. 32+ random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Email (password reset) ---------------------------------------------
# Optional. When unset, reset links are written to the server log (dev only).
# RESEND_API_KEY=
# EMAIL_FROM=GameHub <noreply@example.com>
