{
  "name": "gamehub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.ts",
    "admin:grant": "node scripts/grant-role.ts",
    "words:build": "node scripts/build-wordlists.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:live": "node --env-file=.env.local scripts/test-live.mjs",
    "db:migrate:env": "node --env-file=.env.local scripts/migrate.ts",
    "db:inspect": "node scripts/db-inspect.mjs",
    "ai:seed": "node --conditions=react-server --import tsx ai/scripts/seed-demo.ts",
    "ai:mcp": "node --conditions=react-server --import tsx ai/mcp-server/server.ts",
    "ai:ask": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local ai/agent/cli.ts",
    "ai:demo": "node --conditions=react-server --import tsx ai/scripts/demo.ts",
    "ai:memory-demo": "node --conditions=react-server --import tsx ai/scripts/memory-demo.ts",
    "ai:benchmark": "node --conditions=react-server --import tsx ai/benchmark/run.ts",
    "ai:token": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local ai/scripts/create-token.ts",
    "ai:check": "node --conditions=react-server --import tsx ai/scripts/check-setup.ts",
    "test:ai": "vitest run ai",
    "test:ai:live": "node --env-file=.env.local scripts/test-ai-live.mjs",
    "ops:keep-warm": "node --env-file=.env.local scripts/apply-sql.mjs scripts/keep-warm.sql",
    "ops:guest-cleanup": "node --env-file=.env.local scripts/apply-sql.mjs scripts/guest-cleanup-cron.sql",
    "ops:purge-guests": "node --env-file=.env.local scripts/purge-guests.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "wordlist-english": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
